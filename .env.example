# ============================================================
# LINKUPCHAT — environment template
# Copy to .env for local development, or set these variables in
# your hosting provider's dashboard. NEVER commit real secrets.
# ============================================================

# ---- App ----
# Public URL of the deployment (used in emails and absolute links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Bind settings for the Node server (0.0.0.0 is required on PaaS hosts)
HOST="0.0.0.0"
PORT="3000"

# ---- Database (required) ----
# Hosted PostgreSQL connection string (Prisma). Use the provider's
# "Postgres" or "External Database URL". For connection poolers (PgBouncer),
# prefer the direct/session URL for Prisma migrate.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/linkupchat"

# ---- Auth / sessions ----
# Session lifetime in days (default 30)
SESSION_TTL_DAYS="30"

# ---- Media storage ----
# "local" (disk, dev only) or "s3" (any S3-compatible object storage)
STORAGE_DRIVER="local"
# Local driver: directory for uploaded media (created automatically)
UPLOAD_DIR="./uploads"
# Max upload size in megabytes
MAX_UPLOAD_MB="25"

# S3-compatible object storage (required when STORAGE_DRIVER="s3")
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL for serving stored objects (CDN or bucket URL)
S3_PUBLIC_URL=""

# ---- Email delivery ----
# MAIL_TRANSPORT selects the provider: "smtp" | "http" | "none".
# Leave it unset to auto-detect: SMTP_HOST -> smtp, MAIL_HTTP_URL -> http,
# otherwise none. With no transport configured, development logs a local
# preview; production logs a warning WITHOUT the message body and reports
# delivery as failed (never a fake success).
MAIL_TRANSPORT=""
MAIL_FROM="LINKUPCHAT <no-reply@example.com>"
# SMTP provider (MAIL_TRANSPORT=smtp)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# Transactional HTTP JSON provider (MAIL_TRANSPORT=http): messages are POSTed
# as {from,to,subject,text,html} to MAIL_HTTP_URL with an optional Bearer token.
MAIL_HTTP_URL=""
MAIL_HTTP_TOKEN=""

# ---- Web push notifications (VAPID) ----
# Real web-push delivery (web-push library). Generate keys with:
#   npx web-push generate-vapid-keys
# Set all four values to enable push. When VAPID credentials are missing or
# invalid, push delivery is DISABLED SAFELY: nothing is sent, nothing is
# reported as sent, and the Settings UI shows push as unavailable. Never put
# the private key in any NEXT_PUBLIC_* variable.
#
# VALUE FORMAT (strictly validated by the web-push library):
#   - keys are bare, unpadded, URL-safe base64 (A-Z a-z 0-9 - _) exactly as
#     printed by "npx web-push generate-vapid-keys" — no quotes, no spaces,
#     no line breaks, no "=" padding (wrapping quotes/whitespace are stripped
#     automatically, but paste the bare values);
#   - public key decodes to 65 bytes, private key to 32 bytes;
#   - VAPID_SUBJECT must be an https: URL (e.g. the production URL) or a
#     mailto: address.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
# Same public key as VAPID_PUBLIC_KEY (inlined into the client bundle so the
# service worker can subscribe).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# ---- WebRTC calls (Phase 4E: server-authoritative ICE config) ----
# All optional — calling works (STUN/direct) without them. Configure a managed
# TURN provider (Cloudflare Calls, Metered, Twilio NTS, …) for production NAT
# traversal. Delivered to authenticated clients via GET /api/calls/ice only.
# NEVER use NEXT_PUBLIC_* for TURN credentials (they would be inlined into the
# public client bundle).
STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
TURN_URLS=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ---- Billing (Phase 19) ----
# No card numbers are stored. Secrets stay server-side and must never use
# NEXT_PUBLIC_*. Leave these empty until a provider is configured.
# BILLING_MODE=test enables a labeled simulated checkout. It does not charge
# a card, and a browser redirect is never treated as payment proof.
# BILLING_MODE=live requires the Stripe values below. Without them, checkout
# returns 503 and does not invent a charge.
# Unset BILLING_MODE does not activate subscriptions.
BILLING_MODE=""
BILLING_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PREMIUM_MONTHLY=""
STRIPE_PRICE_PREMIUM_YEARLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""
# Optional absolute URL for checkout return links. Falls back to NEXT_PUBLIC_APP_URL.
APP_URL=""

# ---- Optional ----
# Comma-separated origins allowed to frame the app (X-Frame-Options/CSP).
# Leave empty in production to send X-Frame-Options: DENY.
ALLOWED_FRAME_ORIGINS=""
